<?xml version="1.0" encoding="utf-8"?>
<!--
    Chat flotante del asistente de IA: se agrega ENCIMA del contenido de cada pantalla privada
    (asistente/ui/ChatAsistenteView). La raíz no es clickeable: los toques fuera del panel y de la
    burbuja siguen llegando a la pantalla de abajo. Los márgenes (barras del sistema, menú inferior,
    teclado) se calculan en código.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatAsistenteRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panelChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_chat_panel"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sparkles"
                android:tint="@color/payx_orange" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Asistente PayX"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNuevaCharla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_dark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Nueva charla"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCerrarChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar asistente"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_border" />

        <ScrollView
            android:id="@+id/scrollChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:id="@+id/listaChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/tvErrorChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_error_box"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/color_logout"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/etMensajeChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="Preguntale algo al asistente..."
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="1000"
                android:maxLines="5"
                android:minHeight="44dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnEnviarChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chat_enviar"
                android:contentDescription="Enviar"
                android:enabled="false"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send"
                android:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvContadorChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:gravity="end"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnBurbujaChat"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/bg_chat_fab"
        android:contentDescription="Abrir asistente"
        android:elevation="10dp"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sparkles" />
</FrameLayout>
