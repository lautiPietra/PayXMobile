<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131313"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ══ HEADER ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/payx_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Volver"
                    android:textColor="@color/payx_orange"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnCerrar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_button"
                android:src="@drawable/ic_close"
                android:padding="9dp" />
        </LinearLayout>

        <!-- ══════ FORMULARIO ══════ -->
        <LinearLayout
            android:id="@+id/seccionFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- ══ PRECIOS EN VIVO ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card_borde_sutil"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dot_activo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precios en vivo"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="BTC"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvPrecioBTC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="ETH"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvPrecioETH"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="SOL"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvPrecioSOL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="USDT"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvPrecioUSDT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="BNB"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvPrecioBNB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="XRP"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvPrecioXRP"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Buscando / precio sin actualizar / sin cotización -->
        <TextView
            android:id="@+id/tvEstadoCotizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-10dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ══ TÍTULO ══ -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="Comprar criptomonedas"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:gravity="center"
            android:paddingHorizontal="30dp"
            android:lineSpacingExtra="2dp"
            android:text="Elegí qué criptomoneda comprar y cuánto querés invertir"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- ══ RESUMEN ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvLabelVasA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Vas a pagar"
                android:textColor="@color/payx_orange"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSimboloResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:layout_marginEnd="4dp"
                    android:text="$"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMontoResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0,00"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecibis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_pill_orange_tint"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Recibís BTC 0,00000000"
                android:textColor="@color/payx_orange"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="14dp"
                android:background="@color/card_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLabelPrecio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Precio BTC"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvPrecioSeleccionado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLabelSaldoOrigen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Saldo en pesos"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvSaldoOrigen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Saldo luego de la operación"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSaldoLuego"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ CRIPTOMONEDA: chips como en saldos y transferencias ══ -->
        <TextView
            style="@style/TransferEtiqueta"
            android:text="Criptomoneda" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutCriptos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvMonedaSeleccionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="18dp"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <!-- ══ SALDO DISPONIBLE ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="26dp"
            android:background="@drawable/bg_saldo_disponible"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_credit_card"
                app:tint="@color/payx_orange" />

            <TextView
                android:id="@+id/tvLabelSaldoDisponible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Saldo disponible en pesos"
                android:textColor="@color/payx_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaldoDisponible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ══ MONTO ══ -->
        <TextView
            android:id="@+id/tvLabelMonto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="8dp"
            android:text="Monto en pesos a destinar"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tvSimboloInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="$"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMonto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="0,00"
                android:inputType="numberDecimal"
                android:paddingVertical="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnUsarTodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="Usar todo"
                android:textColor="@color/payx_orange"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ══ NOTA ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="26dp"
            android:background="@drawable/bg_card_borde_sutil"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/payx_orange" />

            <TextView
                android:id="@+id/tvNota"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            style="@style/TransferError"
            android:visibility="gone" />

        <!-- ══ BOTONES ══ -->
        <Button
            android:id="@+id/btnOperar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_orange"
            app:backgroundTint="@null"
            android:drawableStart="@drawable/ic_coins"
            android:drawablePadding="8dp"
            android:drawableTint="@color/white"
            android:gravity="center"
            android:text="Comprar BTC"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_button_outline"
            app:backgroundTint="@null"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        </LinearLayout>

        <!-- ══════ CONFIRMAR: resumen antes de mover plata ══════ -->
        <LinearLayout
            android:id="@+id/seccionConfirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTituloConfirmar"
                style="@style/TransferTitulo"
                android:text="Confirmá la compra" />

            <TextView
                style="@style/TransferSubtitulo"
                android:text="Revisá que los datos sean correctos antes de confirmar" />

            <TextView
                android:id="@+id/tvLabelMontoConfirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvMontoConfirmar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input_dark"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout style="@style/TransferFilaDato">
                    <TextView style="@style/TransferFilaEtiqueta" android:text="Recibís (aprox.)" />
                    <TextView
                        android:id="@+id/tvRecibisConfirmar"
                        style="@style/TransferFilaValor"
                        android:textColor="@color/color_positivo"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout style="@style/TransferFilaDato">
                    <TextView android:id="@+id/tvLabelPrecioConfirmar" style="@style/TransferFilaEtiqueta" android:text="Precio" />
                    <TextView android:id="@+id/tvCotizacionConfirmar" style="@style/TransferFilaValor" />
                </LinearLayout>

                <LinearLayout style="@style/TransferFilaDato">
                    <TextView style="@style/TransferFilaEtiqueta" android:text="Saldo luego de la operación" />
                    <TextView android:id="@+id/tvSaldoLuegoConfirmar" style="@style/TransferFilaValor" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="El monto final se calcula con la cotización vigente al momento de confirmar."
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvErrorConfirmar"
                style="@style/TransferError"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnConfirmar"
                style="@style/TransferBotonPrincipal"
                android:text="Confirmar compra" />

            <Button
                android:id="@+id/btnModificar"
                style="@style/TransferBotonSecundario"
                android:text="Modificar" />
        </LinearLayout>

        <!-- ══════ RESULTADO: éxito (montos REALES del backend) o incierto ══════ -->
        <LinearLayout
            android:id="@+id/seccionResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivIconoResultado"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_icon_badge_cripto"
                android:importantForAccessibility="no"
                android:padding="18dp"
                android:src="@drawable/ic_check"
                app:tint="@color/color_cripto" />

            <TextView
                android:id="@+id/tvTituloResultado"
                style="@style/TransferTitulo" />

            <TextView
                android:id="@+id/tvTextoResultado"
                style="@style/TransferSubtitulo"
                android:layout_marginBottom="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvDetalleResultado"
                style="@style/TransferSubtitulo"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnListo"
                style="@style/TransferBotonPrincipal"
                android:text="Listo" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
