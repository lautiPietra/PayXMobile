<?xml version="1.0" encoding="utf-8"?>
<!-- Paginación local de "Mis movimientos": de a 30, con anterior / números / siguiente -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPaginaAnterior"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Página anterior"
            android:padding="9dp"
            android:rotation="180"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_primary" />

        <LinearLayout
            android:id="@+id/layoutNumerosPagina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <ImageButton
            android:id="@+id/btnPaginaSiguiente"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Página siguiente"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRangoPagina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />
</LinearLayout>
