<?xml version="1.0" encoding="utf-8"?><!--
   La app no respalda nada: ni en la nube ni al pasar de teléfono. El token y la
   conversación del asistente están cifrados con una clave del Keystore que no viaja
   con el respaldo, así que restaurarlos en otro equipo no serviría de nada.
   Con android:allowBackup="false" alcanza en la mayoría de los casos; esto lo deja
   explícito para Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
